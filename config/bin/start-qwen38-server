#!/usr/bin/env bash
set -euo pipefail

model=${HOME}/models/llm/qwen/qwen3.8-27b/Qwen3.8-27B-UD-Q6_K.gguf
draft=${HOME}/models/llm/qwen/qwen3.8-27b/MTP/mtp-Qwen3.8-27B-Q4_0.gguf
mmproj=${HOME}/models/llm/qwen/qwen3.8-27b/mmproj-F16.gguf

for required_file in "$model" "$draft" "$mmproj"; do
  if [[ ! -s "$required_file" ]]; then
    printf 'Missing model file: %s\n' "$required_file" >&2
    exit 1
  fi
done

if pgrep -x llama-server >/dev/null; then
  printf 'A llama-server process is already running. Run stop-qwen-server first.\n' >&2
  exit 1
fi

export LLAMA_CACHE=${HOME}/models/.cache/llama.cpp

exec ${HOME}/.local/bin/llama-server \
  --model "$model" \
  --model-draft "$draft" \
  --mmproj "$mmproj" \
  --n-gpu-layers all \
  --n-gpu-layers-draft all \
  --ctx-size 131072 \
  --cache-type-k q8_0 \
  --cache-type-v q8_0 \
  --flash-attn on \
  --parallel 1 \
  --kv-unified \
  --spec-type draft-mtp \
  --spec-draft-n-max 3 \
  --jinja \
  --reasoning-format deepseek \
  --fit on \
  --fit-target 1536 \
  --tools all \
  --alias qwen3.8-27b \
  --host 127.0.0.1 \
  --port "${LLAMA_PORT:-8080}"
