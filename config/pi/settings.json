        }
      },
      "claude-bridge": {
        "reviewer": {
          "model": "openai-codex/gpt-5.6-terra",
          "thinking": "high",
          "fallbackModels": ["claude-bridge/claude-opus-5:high"]
        }
      }
    }
  },
