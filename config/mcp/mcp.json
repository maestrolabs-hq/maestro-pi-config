{
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated"
      ]
    },
    "playwright-headed": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "mempalace": {
      "command": "mempalace-mcp"
    },
    "github": {
      "command": "github-mcp-server",
      "args": [
        "stdio"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "!gh auth token"
      }
    },
    "graphify": {
      "command": "graphify-mcp",
      "args": [
        "global-graph.json"
      ],
      "cwd": "${HOME}/workspace/MaestroLabs/.maestro/state/providers/graphify"
    },
    "codegraph": {
      "command": "cgc",
      "args": [
        "mcp",
        "start"
      ],
      "env": {
        "CGC_RUNTIME_DB_TYPE": "kuzudb",
        "CGC_RUNTIME_DB_PATH": "${HOME}/workspace/MaestroLabs/.maestro/state/providers/cgc/kuzudb"
      }
    },
    "semantica": {
      "command": "semantica-mcp",
      "env": {
        "SEMANTICA_KG_PATH": "${HOME}/workspace/MaestroLabs/.maestro/state/providers/semantica/global-graph.json"
      }
    }
  }
}
